# Copy to .env and fill in. Tokens come from api.slack.com/apps -> your app.
# Bot User OAuth Token (Install App page). Starts with xoxb-
SLACK_BOT_TOKEN=
# App-Level Token with connections:write scope (Basic Information page). xapp-
SLACK_APP_TOKEN=

# Channel the orchestrator listens/posts in (no leading #). Bot must be a member.
# SLACK_CHANNEL=general-personal

# --- Orchestrator ---
# Claude session the orchestrator drives (resumed each start; shows in GUI recents).
# ORCH_SESSION_ID=d0617ad4-028b-49d1-90d0-ac22327d19f1
# Working dir (access scope). Also settable with --cwd. Default ~/Repos.
# ORCH_CWD=C:\Users\maratcli\Repos

# --- Teams poller ---
# Toggle the background Teams poll loop. Default ON; set 0/false/no/off to disable.
# TEAMS_POLL_ENABLED=1
# Minutes between `teams unreads` polls. Default 10.
# POLL_TIME_SPAN_MINUTES=10
# The teams CLI to invoke. Default `teams` (on PATH).
# TEAMS_CMD=teams
