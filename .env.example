# Copy to .env and fill in. Tokens come from api.slack.com/apps -> your app.
# Bot User OAuth Token (Install App page). Starts with xoxb-
SLACK_BOT_TOKEN=
# App-Level Token with connections:write scope (Basic Information page). xapp-
SLACK_APP_TOKEN=

# Optional: lock the bot to specific Slack user IDs (comma-separated, e.g. U0123ABC).
# Empty = anyone who can DM the bot.
SLACK_ALLOWED_USERS=

# Optional overrides:
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT=180
